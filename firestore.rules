rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------- Helpers

    function signedIn() {
      return request.auth != null;
    }

    // Signed in as the user whose uid is in the path.
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isValidName(name) {
      return name is string && name.size() > 0 && name.size() <= 50;
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isDateKey(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Exactly these fields: no more, no less.
    function hasExactly(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    // An update may change only these fields.
    function onlyChanged(fields) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(fields);
    }

    // --------------------------------------------------- Personal goals

    function userGoalPath(userId, goalId) {
      return /databases/$(database)/documents/users/$(userId)/goals/$(goalId);
    }

    function isValidProfile(data) {
      return data.keys().hasOnly(['name', 'email', 'createdAt'])
        && isValidName(data.name)
        && data.email == request.auth.token.email
        && data.createdAt == request.time;
    }

    function isValidEndDate(goal) {
      return goal.endDate == null
        || (isDateKey(goal.endDate) && goal.endDate >= goal.startDate);
    }

    // Category list must match src/utils/constants.js.
    function isValidGoal(goal) {
      return hasExactly(goal, ['title', 'description', 'category',
          'frequency', 'startDate', 'endDate', 'status', 'createdAt',
          'updatedAt'])
        && isText(goal.title, 1, 100)
        && isText(goal.description, 0, 500)
        && goal.category in ['Health', 'Fitness', 'Learning', 'Career',
          'Finance', 'Mindfulness', 'Personal', 'Other']
        && goal.frequency in ['daily', 'weekly']
        && isDateKey(goal.startDate)
        && isValidEndDate(goal)
        && goal.status in ['active', 'completed']
        && goal.updatedAt == request.time;
    }

    function isValidProgress(data, date) {
      return isDateKey(date)
        && data.keys().hasOnly(['date', 'completedAt'])
        && data.date == date
        && data.completedAt == request.time;
    }

    // Progress only for an existing, active goal, within its dates.
    function canLogProgress(userId, goalId, date) {
      let goalPath = userGoalPath(userId, goalId);
      return exists(goalPath)
        && get(goalPath).data.status == 'active'
        && date >= get(goalPath).data.startDate
        && (get(goalPath).data.endDate == null
          || date <= get(goalPath).data.endDate);
    }

    // ----------------------------------------------------------- Groups

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function memberPath(groupId, uid) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(uid);
    }

    function groupGoalPath(groupId, goalId) {
      return /databases/$(database)/documents/groups/$(groupId)/goals/$(goalId);
    }

    // The group as it is now, and as it will be after this batch.
    function groupData(groupId) {
      return get(groupPath(groupId)).data;
    }

    function groupDataAfter(groupId) {
      return getAfter(groupPath(groupId)).data;
    }

    function isMember(groupId) {
      return signedIn() && exists(memberPath(groupId, request.auth.uid));
    }

    function isGroupOwner(groupId) {
      return signedIn() && groupData(groupId).ownerId == request.auth.uid;
    }

    // Same alphabet as src/utils/groupCode.js (no 0, O, 1, I or L).
    function isGroupCode(value) {
      return value is string
        && value.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{6}$');
    }

    // One start date and an optional end date for all of the group's goals.
    function isValidGroupDates(data) {
      return isDateKey(data.startDate) && isValidEndDate(data);
    }

    function isValidGroup(data) {
      return hasExactly(data, ['name', 'code', 'ownerId', 'ownerName',
          'startDate', 'endDate', 'createdAt'])
        && data.ownerId == request.auth.uid
        && isText(data.name, 1, 60)
        && isValidName(data.ownerName)
        && isGroupCode(data.code)
        && isValidGroupDates(data)
        && data.createdAt == request.time;
    }

    // Joining needs the group's code. The owner joins as 'owner',
    // everyone else as 'member'. getAfter() also sees a group that is
    // created in the same batch.
    function isValidMember(data, groupId) {
      let ownerId = groupDataAfter(groupId).ownerId;
      return hasExactly(data, ['name', 'role', 'code', 'joinedAt'])
        && isValidName(data.name)
        && data.joinedAt == request.time
        && data.code == groupDataAfter(groupId).code
        && ((data.role == 'owner' && ownerId == request.auth.uid)
          || (data.role == 'member' && ownerId != request.auth.uid));
    }

    // Dates live on the group, not the goal. createdAt is checked by the
    // create and update rules.
    function isValidGroupGoal(data) {
      return hasExactly(data, ['title', 'description', 'frequency',
          'createdAt', 'updatedAt'])
        && isText(data.title, 1, 100)
        && isText(data.description, 0, 500)
        && data.frequency in ['daily', 'weekly']
        && data.updatedAt == request.time;
    }

    // Check-ins only within the group's dates. Groups created before dates
    // existed have no startDate, so any date is allowed for them.
    function isWithinGroupDates(groupId, date) {
      let group = groupData(groupId);
      return date >= group.get('startDate', '')
        && (group.get('endDate', null) == null || date <= group.endDate);
    }

    // Your own check-in, or the owner filling in for a current member.
    function canCheckInFor(groupId, uid) {
      return uid == request.auth.uid
        || (isGroupOwner(groupId) && exists(memberPath(groupId, uid)));
    }

    // The ID is {goalId}_{date}_{uid}: one check-in per goal, date, person.
    function isValidCheckin(data, groupId, checkinId) {
      return hasExactly(data, ['goalId', 'uid', 'name', 'date', 'note',
          'completedAt'])
        && canCheckInFor(groupId, data.uid)
        && data.goalId is string
        && isDateKey(data.date)
        && checkinId == data.goalId + '_' + data.date + '_' + data.uid
        && isValidName(data.name)
        && isText(data.note, 0, 140)
        && data.completedAt == request.time
        && exists(groupGoalPath(groupId, data.goalId))
        && isWithinGroupDates(groupId, data.date);
    }

    // ------------------------------------------------------------ Rules

    // User profile: users/{uid}
    match /users/{userId} {
      allow read: if isOwner(userId);

      // Created once at sign-up.
      allow create: if isOwner(userId)
        && isValidProfile(request.resource.data);

      // Only the name can change later.
      allow update: if isOwner(userId)
        && onlyChanged(['name'])
        && isValidName(request.resource.data.name);

      allow delete: if false;

      // Goals: users/{uid}/goals/{goalId}
      match /goals/{goalId} {
        allow read, delete: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidGoal(request.resource.data)
          && request.resource.data.createdAt == request.time;

        // createdAt can never change after creation.
        allow update: if isOwner(userId)
          && isValidGoal(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;

        // Progress: users/{uid}/goals/{goalId}/progress/{YYYY-MM-DD}
        // Create only, so the same date can never be saved twice.
        match /progress/{date} {
          allow read, delete: if isOwner(userId);

          allow create: if isOwner(userId)
            && isValidProgress(request.resource.data, date)
            && canLogProgress(userId, goalId, date);

          allow update: if false;
        }
      }

      // Groups this user is in: users/{uid}/groupMemberships/{groupId}
      // Only lists "my groups"; access is checked on the group itself.
      match /groupMemberships/{groupId} {
        allow read, delete: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['joinedAt'])
          && request.resource.data.joinedAt == request.time;

        allow update: if false;
      }
    }

    // Group: groups/{groupId}
    match /groups/{groupId} {
      allow read: if isMember(groupId);

      allow create: if signedIn()
        && isValidGroup(request.resource.data);

      // The owner may change the dates, and nothing else.
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && onlyChanged(['startDate', 'endDate'])
        && isValidGroupDates(request.resource.data);

      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;

      // Members: groups/{groupId}/members/{uid}
      match /members/{memberId} {
        allow read: if isMember(groupId);

        // You can only add yourself.
        allow create: if signedIn()
          && memberId == request.auth.uid
          && isValidMember(request.resource.data, groupId);

        allow update: if false;

        // Leave yourself, or the owner removes you when deleting the group.
        allow delete: if signedIn()
          && (memberId == request.auth.uid || isGroupOwner(groupId));
      }

      // Shared goals: only the owner adds, edits or deletes them.
      match /goals/{goalId} {
        allow read: if isMember(groupId);

        allow create: if isGroupOwner(groupId)
          && isValidGroupGoal(request.resource.data)
          && request.resource.data.createdAt == request.time;

        // createdAt can never change after creation.
        allow update: if isGroupOwner(groupId)
          && isValidGroupGoal(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if isGroupOwner(groupId);
      }

      // Members' status: groups/{groupId}/checkins/{goalId}_{date}_{uid}
      match /checkins/{checkinId} {
        allow read: if isMember(groupId);

        allow create: if isMember(groupId)
          && isValidCheckin(request.resource.data, groupId, checkinId);

        // Only the note changes: by its member, or by the owner.
        allow update: if isMember(groupId)
          && (resource.data.uid == request.auth.uid || isGroupOwner(groupId))
          && onlyChanged(['note'])
          && isText(request.resource.data.note, 0, 140);

        // Members undo their own; the owner can clear any.
        allow delete: if signedIn()
          && (resource.data.uid == request.auth.uid
            || isGroupOwner(groupId));
      }
    }

    // Join codes: groupCodes/{CODE} holds { groupId }.
    // You may read one code you already know, but never list them.
    match /groupCodes/{code} {
      allow get: if signedIn();

      // Created with its group. Create only, so a code is never taken over.
      allow create: if signedIn()
        && isGroupCode(code)
        && request.resource.data.keys().hasOnly(['groupId'])
        && groupDataAfter(request.resource.data.groupId).code == code
        && groupDataAfter(request.resource.data.groupId).ownerId
          == request.auth.uid;

      allow update: if false;

      allow delete: if signedIn()
        && groupData(resource.data.groupId).ownerId == request.auth.uid;
    }

    // Everything else stays denied.
  }
}
