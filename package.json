{
  "name": "accountability",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore --project demo-accountability \"node --test tests/*.test.js\"",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules",
    "test": "node --test tests/stats.test.js"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.34.1",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@firebase/rules-unit-testing": {
      "firebase": "$firebase"
    }
  }
}
